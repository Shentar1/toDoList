generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model jobs {
  id              Int       @id @default(autoincrement())
  job_description String?
  list_id         Int
  status          String?   @db.VarChar
  time_created    DateTime @db.Timestamp(6)
  lists           lists     @relation(fields: [list_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "job_list")
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model lists {
  id           Int       @id @default(autoincrement())
  list_name    String    @db.VarChar
  user_uuid    String   @db.Uuid
  time_created DateTime @db.Timestamp(6)
  jobs         jobs[]
  users        users?     @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade, onUpdate: Cascade, map: "user_lists")
}

model users {
  id           Int       @id @default(autoincrement())
  uuid         String    @default(uuid()) @unique @db.Uuid
  username     String    @db.VarChar @unique
  password     String    @db.VarChar
  time_created DateTime @db.Timestamp(6)
  role         String   @db.VarChar
  lists        lists[]
}
